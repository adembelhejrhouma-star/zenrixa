{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "stripe": {
      "type": "local",
      "command": ["npx", "-y", "@stripe/mcp@latest"],
      "enabled": true,
      "environment": {
        "STRIPE_SECRET_KEY": "{env:STRIPE_SECRET_KEY}"
      }
    },
    "testsprite": {
      "type": "local",
      "command": ["npx", "-y", "@testsprite/testsprite-mcp@latest"],
      "enabled": true,
      "environment": {
        "API_KEY": "{env:TESTSPRITE_API_KEY}"
      }
    }
  },
  "provider": {
    "manifest": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Manifest",
      "options": {
        "baseURL": "https://app.manifest.build/v1",
        "apiKey": "{env:MANIFEST_API_KEY}"
      },
      "models": {
        "auto": {
          "name": "Manifest Auto"
        }
      }
    }
  },
  "model": "manifest/auto"
}