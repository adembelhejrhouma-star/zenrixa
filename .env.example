# =====================================================================
#  Zenrixa — environment variable template
#  1. Copy this file to `.env.local` (which is gitignored).
#  2. Fill in real values.
#  NEVER commit `.env` / `.env.local` / any `.env.*` file.
# =====================================================================

# ---------------------------------------------------------------------
# PUBLIC keys — safe to expose to the browser.
# Used by the Next.js app (utils/supabase/*.ts, app/api/*).
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe publishable key (starts with pk_). Public by design.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# NOTE: public/js/*.js files are served as-is by Next.js and are NOT compiled,
# so NEXT_PUBLIC_* vars are not inlined into them. The static pages fetch these
# values at runtime from the /api/config endpoint (see app/api/config/route.ts),
# which populates window.__ZENRIXA_ENV__ in public/js/supabase-config.js and
# public/js/stripe.js.

# ---------------------------------------------------------------------
# SECRET keys — NEVER put real values in this file.
# Set them ONLY on the server side:
#   - Supabase Edge Functions:  supabase secrets set NAME=value
#   - Vercel:  Project > Settings > Environment Variables
# ---------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# RESEND_API_KEY=re_xxx
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------------------------------------------------------------------
# Local tooling only (never used by the deployed app).
# TestSprite API key referenced from opencode.json — NOT for Vercel.
# Set the real value as an OS environment variable (Windows:
# `setx TESTSPRITE_API_KEY sk-user-...`) and restart opencode.
# ---------------------------------------------------------------------
TESTSPRITE_API_KEY=your_testsprite_api_key_here
